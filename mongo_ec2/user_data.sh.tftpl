#!/bin/bash
set -Eeuo pipefail

exec > >(tee -a /var/log/mongodb-bootstrap.log | logger -t mongodb-bootstrap -s 2>/dev/console) 2>&1

# -------------------------------------------------------------------
# 1. Terraform-provided configuration
# -------------------------------------------------------------------

AWS_REGION="${aws_region}"
SECRET_ARN="${secret_arn}"
DATABASE_NAME="${database_name}"
DATA_VOLUME_ID="${data_volume_id}"
ENVIRONMENT="${environment}"

MOUNT_POINT="/var/lib/mongodb"
MONGODB_CONFIG="/etc/mongod.conf"

echo "Starting MongoDB bootstrap for environment: $ENVIRONMENT"

export DEBIAN_FRONTEND=noninteractive

# -------------------------------------------------------------------
# 2. Install dependencies
# -------------------------------------------------------------------

apt-get update

apt-get install -y \
  awscli \
  ca-certificates \
  curl \
  gnupg \
  jq \
  nvme-cli \
  openssl \
  xfsprogs

# -------------------------------------------------------------------
# 3. Retrieve credentials from Secrets Manager
# -------------------------------------------------------------------

echo "Retrieving MongoDB credentials..."

SECRET_JSON=""

for attempt in $(seq 1 30); do
  if SECRET_JSON="$(aws secretsmanager get-secret-value \
    --region "$AWS_REGION" \
    --secret-id "$SECRET_ARN" \
    --query SecretString \
    --output text 2>/dev/null)"; then
    break
  fi

  echo "Secrets Manager unavailable. Retry $attempt/30..."
  sleep 10
done

if [[ -z "$SECRET_JSON" || "$SECRET_JSON" == "None" ]]; then
  echo "ERROR: Could not retrieve MongoDB credentials."
  exit 1
fi

MONGO_ADMIN_USERNAME="$(jq -er '.admin.username' <<< "$SECRET_JSON")"
MONGO_ADMIN_PASSWORD="$(jq -er '.admin.password' <<< "$SECRET_JSON")"

MONGO_APPLICATION_USERNAME="$(jq -er '.application.username' <<< "$SECRET_JSON")"
MONGO_APPLICATION_PASSWORD="$(jq -er '.application.password' <<< "$SECRET_JSON")"

SECRET_DATABASE="$(jq -er '.database' <<< "$SECRET_JSON")"

if [[ -z "$MONGO_ADMIN_USERNAME" || -z "$MONGO_ADMIN_PASSWORD" ]]; then
  echo "ERROR: Administrator credentials are missing."
  exit 1
fi

if [[ -z "$MONGO_APPLICATION_USERNAME" || -z "$MONGO_APPLICATION_PASSWORD" ]]; then
  echo "ERROR: Application credentials are missing."
  exit 1
fi

if [[ "$SECRET_DATABASE" != "$DATABASE_NAME" ]]; then
  echo "ERROR: Database name in Secrets Manager does not match Terraform configuration."
  exit 1
fi

# The same username cannot have two different passwords in this setup.
if [[ "$MONGO_ADMIN_USERNAME" == "$MONGO_APPLICATION_USERNAME" ]] &&
   [[ "$MONGO_ADMIN_PASSWORD" != "$MONGO_APPLICATION_PASSWORD" ]]; then
  echo "ERROR: Admin and application usernames are identical but passwords differ."
  exit 1
fi

unset SECRET_JSON

# -------------------------------------------------------------------
# 4. Locate and prepare the dedicated EBS data volume
# -------------------------------------------------------------------

echo "Waiting for EBS volume $DATA_VOLUME_ID..."

VOLUME_ID_NORMALIZED="$(printf '%s' "$DATA_VOLUME_ID" | tr -d '-')"
DEVICE=""

for attempt in $(seq 1 120); do
  for candidate in /dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_*; do
    [[ -e "$candidate" ]] || continue

    if [[ "$(basename "$candidate")" == *"$VOLUME_ID_NORMALIZED"* ]]; then
      DEVICE="$(readlink -f "$candidate")"
      break
    fi
  done

  [[ -n "$DEVICE" ]] && break

  sleep 5
done

if [[ -z "$DEVICE" ]]; then
  echo "ERROR: Could not locate the attached EBS data volume."
  lsblk
  exit 1
fi

echo "Found MongoDB data device: $DEVICE"

mkdir -p "$MOUNT_POINT"

# Only format a completely new, unformatted volume.
if ! blkid "$DEVICE" >/dev/null 2>&1; then
  echo "Creating XFS filesystem on the new MongoDB volume..."
  mkfs.xfs -f -L MONGODB_DATA "$DEVICE"
fi

FILESYSTEM_UUID="$(blkid -s UUID -o value "$DEVICE")"

if [[ -z "$FILESYSTEM_UUID" ]]; then
  echo "ERROR: Could not determine the data volume filesystem UUID."
  exit 1
fi

if ! grep -q "$FILESYSTEM_UUID" /etc/fstab; then
  echo "UUID=$FILESYSTEM_UUID $MOUNT_POINT xfs defaults,nofail 0 2" >> /etc/fstab
fi

if ! mountpoint -q "$MOUNT_POINT"; then
  mount "$MOUNT_POINT"
fi

if ! mountpoint -q "$MOUNT_POINT"; then
  echo "ERROR: MongoDB data volume is not mounted."
  exit 1
fi

# -------------------------------------------------------------------
# 5. Install MongoDB Community Edition 8.0
# -------------------------------------------------------------------

echo "Installing MongoDB Community Edition..."

curl -fsSL https://www.mongodb.org/static/pgp/server-8.0.asc \
  | gpg --dearmor --yes -o /usr/share/keyrings/mongodb-server-8.0.gpg

echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/8.0 multiverse" \
  > /etc/apt/sources.list.d/mongodb-org-8.0.list

apt-get update
apt-get install -y mongodb-org

# -------------------------------------------------------------------
# 6. Configure persistent MongoDB storage
# -------------------------------------------------------------------

chown mongodb:mongodb "$MOUNT_POINT"
chmod 700 "$MOUNT_POINT"

# -------------------------------------------------------------------
# 7. Configure MongoDB authentication and network binding
# -------------------------------------------------------------------

cat > "$MONGODB_CONFIG" <<EOF
storage:
  dbPath: $MOUNT_POINT

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: 27017
  bindIp: 127.0.0.1,0.0.0.0

processManagement:
  timeZoneInfo: /usr/share/zoneinfo

security:
  authorization: enabled
EOF

chown root:mongodb "$MONGODB_CONFIG"
chmod 640 "$MONGODB_CONFIG"

# -------------------------------------------------------------------
# 8. Start MongoDB
# -------------------------------------------------------------------

systemctl enable mongod
systemctl start mongod

MONGO_READY="false"

for attempt in $(seq 1 60); do
  if mongosh --quiet --eval 'db.adminCommand({ ping: 1 }).ok' 2>/dev/null \
      | grep -q '1'; then
    MONGO_READY="true"
    break
  fi

  sleep 2
done

if [[ "$MONGO_READY" != "true" ]]; then
  echo "ERROR: MongoDB did not become ready."
  systemctl status mongod --no-pager || true
  exit 1
fi

# -------------------------------------------------------------------
# 9. Initialize or verify the administrator
# -------------------------------------------------------------------

echo "Checking MongoDB administrator..."

export MONGO_ADMIN_USERNAME
export MONGO_ADMIN_PASSWORD

if MONGO_AUTH_OK="$(
  mongosh --quiet admin --eval '
    const result = db.auth(
      process.env.MONGO_ADMIN_USERNAME,
      process.env.MONGO_ADMIN_PASSWORD
    );

    if (result !== 1) {
      quit(1);
    }

    quit(0);
  ' 2>/dev/null
)"; then
  echo "Existing administrator authentication succeeded."
else
  echo "Administrator authentication failed. Attempting first-user initialization..."

  # MongoDB's localhost exception permits creation of the first user
  # only when the database has no users or roles yet.
  # If users already exist, this will fail safely rather than bypass auth.

  mongosh --quiet admin --eval '
    const username = process.env.MONGO_ADMIN_USERNAME;
    const password = process.env.MONGO_ADMIN_PASSWORD;

    if (!username || !password) {
      throw new Error("Administrator credentials are missing.");
    }

    if (db.getUser(username)) {
      throw new Error(
        "Administrator already exists but supplied credentials cannot authenticate."
      );
    }

    db.createUser({
      user: username,
      pwd: password,
      roles: [
        { role: "root", db: "admin" }
      ]
    });
  '

  echo "Administrator created."
fi

# -------------------------------------------------------------------
# 10. Create or update the application user
# -------------------------------------------------------------------

if [[ "$MONGO_ADMIN_USERNAME" == "$MONGO_APPLICATION_USERNAME" ]]; then
  echo "Admin and application usernames are identical."
  echo "Skipping duplicate application-user creation."
  echo "Application authentication source will be admin."
else
  echo "Configuring separate application user..."

  export MONGO_APPLICATION_USERNAME
  export MONGO_APPLICATION_PASSWORD
  export MONGO_DATABASE_NAME="$DATABASE_NAME"

  mongosh --quiet admin --eval '
    const adminAuth = db.auth(
      process.env.MONGO_ADMIN_USERNAME,
      process.env.MONGO_ADMIN_PASSWORD
    );

    if (adminAuth !== 1) {
      throw new Error("Administrator authentication failed.");
    }

    const databaseName = process.env.MONGO_DATABASE_NAME;
    const username = process.env.MONGO_APPLICATION_USERNAME;
    const password = process.env.MONGO_APPLICATION_PASSWORD;

    const applicationDb = db.getSiblingDB(databaseName);
    const existingUser = applicationDb.getUser(username);

    if (existingUser) {
      applicationDb.updateUser(username, {
        pwd: password,
        roles: [
          { role: "readWrite", db: databaseName }
        ]
      });
    } else {
      applicationDb.createUser({
        user: username,
        pwd: password,
        roles: [
          { role: "readWrite", db: databaseName }
        ]
      });
    }
  '

  echo "Application user configured."
fi

# -------------------------------------------------------------------
# 11. Verify application authentication
# -------------------------------------------------------------------

if [[ "$MONGO_ADMIN_USERNAME" == "$MONGO_APPLICATION_USERNAME" ]]; then
  MONGO_AUTH_SOURCE="admin"
  VERIFY_USERNAME="$MONGO_ADMIN_USERNAME"
  VERIFY_PASSWORD="$MONGO_ADMIN_PASSWORD"
else
  MONGO_AUTH_SOURCE="$DATABASE_NAME"
  VERIFY_USERNAME="$MONGO_APPLICATION_USERNAME"
  VERIFY_PASSWORD="$MONGO_APPLICATION_PASSWORD"
fi

export MONGO_AUTH_SOURCE
export VERIFY_USERNAME
export VERIFY_PASSWORD

mongosh --quiet "$DATABASE_NAME" --eval '
  const result = db.auth(
    process.env.VERIFY_USERNAME,
    process.env.VERIFY_PASSWORD
  );

  if (result !== 1) {
    throw new Error("Application authentication verification failed.");
  }

  const ping = db.adminCommand({ ping: 1 });

  if (ping.ok !== 1) {
    throw new Error("MongoDB ping verification failed.");
  }
'

# -------------------------------------------------------------------
# 12. Cleanup and final checks
# -------------------------------------------------------------------

unset MONGO_ADMIN_USERNAME
unset MONGO_ADMIN_PASSWORD
unset MONGO_APPLICATION_USERNAME
unset MONGO_APPLICATION_PASSWORD
unset MONGO_DATABASE_NAME
unset VERIFY_USERNAME
unset VERIFY_PASSWORD
unset MONGO_AUTH_SOURCE

if ! mountpoint -q "$MOUNT_POINT"; then
  echo "ERROR: MongoDB data volume is not mounted."
  exit 1
fi

if ! systemctl is-active --quiet mongod; then
  echo "ERROR: MongoDB service is not active."
  systemctl status mongod --no-pager || true
  exit 1
fi

if ! systemctl is-enabled --quiet mongod; then
  echo "ERROR: MongoDB is not enabled at boot."
  exit 1
fi

echo "MongoDB bootstrap completed successfully."
echo "Environment: $ENVIRONMENT"
echo "Database: $DATABASE_NAME"
echo "Data directory: $MOUNT_POINT"
echo "Authentication source: $MONGO_AUTH_SOURCE"
echo "MongoDB port: 27017"